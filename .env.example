# Graph Analytics AI - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================================================
# ArangoDB Connection (Required for all deployments)
# ============================================================================
ARANGO_ENDPOINT=https://your-cluster.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=your-password-here
ARANGO_DATABASE=your-database-name

# Optional: SSL verification (default: true)
# Set to false only for development/testing with self-signed certificates
ARANGO_VERIFY_SSL=true

# Optional: Connection timeout in seconds (default: 30)
ARANGO_TIMEOUT=30

# ============================================================================
# GAE Deployment Mode
# ============================================================================
# Set to either 'amp' or 'self_managed'
GAE_DEPLOYMENT_MODE=amp

# ============================================================================
# AMP (Arango Managed Platform) Configuration
# ============================================================================
# Required when GAE_DEPLOYMENT_MODE=amp
ARANGO_GRAPH_API_KEY_ID=your-api-key-id
ARANGO_GRAPH_API_KEY_SECRET=your-api-key-secret

# Optional: Pre-generated token (if you have one)
# ARANGO_GRAPH_TOKEN=your-token-here

# Optional: GAE port (default: 8829)
ARANGO_GAE_PORT=8829

# ============================================================================
# Self-Managed Configuration
# ============================================================================
# When GAE_DEPLOYMENT_MODE=self_managed, no additional GAE credentials needed
# The library will use JWT tokens from ArangoDB connection

# ============================================================================
# Example Configurations
# ============================================================================

# Example: AMP Deployment
# ARANGO_ENDPOINT=https://mycluster.arangodb.cloud:8529
# ARANGO_USER=root
# ARANGO_PASSWORD=secure-password
# ARANGO_DATABASE=mydb
# GAE_DEPLOYMENT_MODE=amp
# ARANGO_GRAPH_API_KEY_ID=abc123
# ARANGO_GRAPH_API_KEY_SECRET=xyz789

# Example: Self-Managed Deployment
# ARANGO_ENDPOINT=https://my-server.local:8529
# ARANGO_USER=root
# ARANGO_PASSWORD=secure-password
# ARANGO_DATABASE=mydb
# ARANGO_VERIFY_SSL=false
# GAE_DEPLOYMENT_MODE=self_managed

# ============================================================================
# LLM Configuration (Optional - For AI-Assisted Workflow)
# ============================================================================
# OpenRouter Configuration (Recommended - Access to multiple LLM providers)
# https://openrouter.ai/
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=google/gemini-2.0-flash-001:free
# Alternative models:
# - google/gemini-2.5-flash (6-30s Deep Search, avg 11s)
# - anthropic/claude-3.5-sonnet
# - openai/gpt-4o

# LLM Provider Selection (openrouter, openai, anthropic, custom)
# LLM_PROVIDER=openrouter

# OpenAI Configuration (if using LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4

# Anthropic Configuration (if using LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Custom LLM Configuration (if using LLM_PROVIDER=custom)
# CUSTOM_LLM_BASE_URL=https://your-llm-api.com/v1
# CUSTOM_LLM_API_KEY=your-api-key
# CUSTOM_LLM_MODEL=your-model-name

# LLM Generation Parameters
# LLM_MAX_TOKENS=4000
# LLM_TEMPERATURE=0.7

# ============================================================================
# AI Workflow Configuration (Optional)
# ============================================================================
# Enable AI-assisted workflow features
# AI_WORKFLOW_ENABLED=false

# Output directory for workflow artifacts
# WORKFLOW_OUTPUT_DIR=./workflow_output

# Enable checkpoint/resume functionality
# WORKFLOW_CHECKPOINT_ENABLED=true

# Workflow mode: 'linear' or 'agentic'
# WORKFLOW_MODE=linear

